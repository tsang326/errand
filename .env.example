# Channel3 product search. Key from https://trychannel3.com/developers
# Leave empty to run on bundled fixtures instead of the live API.
CHANNEL3_API_KEY=

# PayPal REST app (sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# OpenAI, for the shopping agent's planning and ranking steps
OPENAI_API_KEY=

PORT=8787

# Per-IP ceiling on /api/errand, the only route that spends money
# (server/src/http/ratelimit.ts). Defaults: 30 per IP per hour, 90 for everyone.
ERRAND_RATE_PER_HOUR=
ERRAND_RATE_GLOBAL_PER_HOUR=
ERRAND_RATE_WINDOW_MS=

# What a pass costs and what it buys. Set here, never by the browser: a pass is
# Errand's own product. Defaults: 25 errands for 3.00 USD.
PASS_RUNS=
PASS_PRICE=
PASS_CURRENCY=
# Errands an address gets without buying a pass. Default 5 an hour.
ERRAND_FREE_RUNS_PER_HOUR=
