# Channel3 product search. Key from https://trychannel3.com/developers
# Leave empty to run on bundled fixtures instead of the live API.
CHANNEL3_API_KEY=

# PayPal REST app (sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true
# From the webhook you create in the PayPal developer dashboard, pointed at
# <public url>/api/paypal/webhook. Without it the webhook route refuses every
# notification, because an unverified notification cannot be told from a forgery.
PAYPAL_WEBHOOK_ID=

# OpenAI, for the shopping agent's planning and ranking steps
OPENAI_API_KEY=

PORT=8787

# Per-IP ceiling on /api/errand, the only route that spends money
# (server/src/http/ratelimit.ts). Defaults: 30 per IP per hour, 90 for everyone.
ERRAND_RATE_PER_HOUR=
ERRAND_RATE_GLOBAL_PER_HOUR=
ERRAND_RATE_WINDOW_MS=

# What a pass costs and what it buys. Set here, never by the browser: a pass is
# Errand's own product. Defaults: 15 errands for 3.00 USD.
PASS_RUNS=
PASS_PRICE=
PASS_CURRENCY=
# Errands an address gets without buying a pass. Default 5 a day: per hour it
# came to more free errands than a pass sells, so the pass was priced above
# something already free.
ERRAND_FREE_RUNS_PER_DAY=
# The same allowance per address, which has to be looser: an office or a mobile
# carrier is one address and many people. Default 25, five devices' worth.
ERRAND_FREE_RUNS_PER_ADDRESS_DAY=
# Pages of the Channel3 index a paid errand reads, against one for a free
# errand. Default 3, so about 70 products are judged instead of 24.
CHANNEL3_PAID_PAGES=
